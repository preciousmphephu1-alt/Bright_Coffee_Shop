SELECT *
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;

---Checking duplicates
SELECT count(*) as total_records,
       Count(distinct transaction_id) as unique_transactions
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;

---Checking nulls and blanks
SELECT count(*) as missing_products
      FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
      WHERE product_detail IS NULL OR product_detail = '';
      ---No nulls or blanks


---Asking the business question
--QUESTION 1
-- What kind of products is the coffee shop currently offering?

SELECT DISTINCT-- DISTINCT removes duplicates
    product_category,
    product_type,
    product_detail

FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset

ORDER BY
    product_category,
    product_type,
    product_detail;


   -- QUESTION 2
-- Which product category is bought the most by customers?
SELECT
product_category,
SUM(transaction_qty) AS total_units_sold ---SUM(transaction_qty) calculates the total number of units
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY product_category
ORDER BY total_units_sold DESC;-- DESC puts the highest-selling category first

-- QUESTION 3
-- Which product category is bought the least by customers?
SELECT
    product_category,
    SUM(transaction_qty) AS total_units_sold
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY product_category
ORDER BY total_units_sold ASC;

-- QUESTION 4
-- Which product category was bought the most by customers in the last month?
-- The dataset contains January to June 2023 ,Therefore, June 2023 is the latest month.

SELECT
    product_category,
     SUM(transaction_qty) AS total_units_sold
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
WHERE transaction_date >= '2023-06-01'
  AND transaction_date < '2023-07-01'
GROUP BY product_category
ORDER BY total_units_sold DESC;

--QUESTION 5
-- What time of day does the coffee shop receive the highest sales?

SELECT

    CASE
        WHEN HOUR(transaction_time) BETWEEN 6 AND 11 THEN 'Morning'---Transactions made in the morning
        WHEN HOUR(transaction_time) BETWEEN 12 AND 17 THEN 'Afternoon'---Transactions made in the afternoon
        WHEN HOUR(transaction_time) BETWEEN 18 AND 23 THEN 'Evening'---Transactions made in the evening
        ELSE 'Other'
    END AS time_of_day,
    SUM(transaction_qty) AS total_units_sold,---calculating the total number of units
    SUM(transaction_qty * unit_price) AS total_revenue ---Calculating the total revenue

FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset

GROUP BY
    CASE
        WHEN HOUR(transaction_time) BETWEEN 6 AND 11 THEN 'Morning'
        WHEN HOUR(transaction_time) BETWEEN 12 AND 17 THEN 'Afternoon'
        WHEN HOUR(transaction_time) BETWEEN 18 AND 23 THEN 'Evening'
        ELSE 'Other'
    END

ORDER BY total_revenue DESC;

-- QUESTION 6
-- Which store location generates the most revenue?
-- We will calculate each stores revenue like this ,Revenue = transaction quantity × unit price.
---This will help us see which store makes the most revenue and which one makes the least

SELECT
    store_location,
    SUM(transaction_qty) AS total_units_sold,
    SUM(transaction_qty * unit_price) AS total_revenue
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY store_location
ORDER BY total_revenue DESC;

 ---QUESTION 7
-- What are the business hours of the coffee shop?
-- This will shows us the earliest and latest transaction time recorded in the dataset.

SELECT
    MIN(transaction_time) AS earliest_transaction_time,-- MIN gives the earliest recorded transaction.
    MAX(transaction_time) AS latest_transaction_time ---MAX gives the latest recorded transaction.
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;
--We can also use this to find the business hours of the coffee shop.
--We can use this to determine the opening and closing hours of the coffee shop.
SELECT
    MIN(HOUR(transaction_time)) AS earliest_hour,
    MAX(HOUR(transaction_time)) AS latest_hour
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;

---Checking when the first transaction was made and the last transaction was made(Between jan-june)
SELECT
    MIN(transaction_date) AS first_transaction_date,
    MAX(transaction_date) AS last_transaction_date
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;


--QUESTION 8
-- Calculating What the total revenue generated by the coffee shop is
---This will help us determine the total revenue generated by the coffee shop
SELECT
    SUM(transaction_qty * unit_price) AS total_revenue
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset;

--QUESTION 9
-- Which product type is the best-selling?
-- This will help us know which product type is the best-selling and we can also know which product type is the least-selling

SELECT
    product_type,
    SUM(transaction_qty) AS total_units_sold
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY product_type
ORDER BY total_units_sold DESC;

 ---QUESTION 10
-- How does revenue change from January to June 2023?
SELECT
    DATE_FORMAT(transaction_date, 'yyyy-MM') AS sales_month,
    SUM(transaction_qty) AS total_units_sold,
    SUM(transaction_qty * unit_price) AS total_revenue
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY
    DATE_FORMAT(transaction_date, 'yyyy-MM')---grouping the data by month to identify the revenue trend.
ORDER BY sales_month;

---QUESTION 11

-- Which product types have the lowest sales?
-- This helps identify products with the lowest sales and may require further investigation as to what can the business do to improve sales and increase sales

SELECT
    product_type,
    SUM(transaction_qty) AS total_units_sold, ---Total units sold
    SUM(transaction_qty * unit_price) AS total_revenue --Total revenue generated
FROM brightcoffeeshop.coffee_shop_table.bright_coffeeshop_dataset
GROUP BY product_type
-- Lowest quantity sold appears first
ORDER BY total_units_sold ASC;



